CREATE USER SA PASSWORD DIGEST 'd41d8cd98f00b204e9800998ecf8427e'
ALTER USER SA SET LOCAL TRUE
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.SEQ_USER_ID AS INTEGER START WITH 1
CREATE SEQUENCE PUBLIC.SEQ_HISTORY_ID AS INTEGER START WITH 1
CREATE MEMORY TABLE PUBLIC.USER_INFORMATION_TBL(USER_ID BIGINT GENERATED BY DEFAULT AS SEQUENCE PUBLIC.SEQ_USER_ID NOT NULL PRIMARY KEY,USER_NAME VARCHAR(100) NOT NULL,MAIL_ADDRESS VARCHAR(255) NOT NULL,PASSWORD VARCHAR(255) NOT NULL,STATUS INTEGER NOT NULL,CREATE_DATETIME TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,UPDATE_DATETIME TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP NOT NULL,VERSION INTEGER DEFAULT 1 NOT NULL,UNIQUE(USER_NAME),UNIQUE(MAIL_ADDRESS))
CREATE MEMORY TABLE PUBLIC.GAME_TYPE_MST(GAME_TYPE_ID INTEGER PRIMARY KEY,GAME_NAME VARCHAR(50) NOT NULL)
CREATE MEMORY TABLE PUBLIC.RESULT_MST(RESULT_ID INTEGER PRIMARY KEY,RESULT_NAME VARCHAR(20) NOT NULL)
CREATE MEMORY TABLE PUBLIC.GAME_RESULT_MST(GAME_TYPE_ID INTEGER NOT NULL,RESULT_ID INTEGER NOT NULL,PRIMARY KEY(GAME_TYPE_ID,RESULT_ID),FOREIGN KEY(GAME_TYPE_ID) REFERENCES PUBLIC.GAME_TYPE_MST(GAME_TYPE_ID),FOREIGN KEY(RESULT_ID) REFERENCES PUBLIC.RESULT_MST(RESULT_ID))
CREATE MEMORY TABLE PUBLIC.RESULT_HISTORY_TBL(HISTORY_ID BIGINT GENERATED BY DEFAULT AS SEQUENCE PUBLIC.SEQ_HISTORY_ID NOT NULL PRIMARY KEY,USER_ID BIGINT NOT NULL,GAME_TYPE_ID INTEGER NOT NULL,RESULT_ID INTEGER NOT NULL,EXECUTE_DATETIME TIMESTAMP NOT NULL,OPPONENT BIGINT NOT NULL,USER_CHOICE VARCHAR(10),CREATE_DATETIME TIMESTAMP NOT NULL,UPDATE_DATETIME TIMESTAMP NOT NULL,VERSION INTEGER NOT NULL,FOREIGN KEY(GAME_TYPE_ID,RESULT_ID) REFERENCES PUBLIC.GAME_RESULT_MST(GAME_TYPE_ID,RESULT_ID),FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USER_INFORMATION_TBL(USER_ID),FOREIGN KEY(OPPONENT) REFERENCES PUBLIC.USER_INFORMATION_TBL(USER_ID))
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
ALTER SEQUENCE PUBLIC.SEQ_USER_ID RESTART WITH 4
ALTER SEQUENCE PUBLIC.SEQ_HISTORY_ID RESTART WITH 153
SET DATABASE DEFAULT INITIAL SCHEMA PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CARDINAL_NUMBER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.YES_OR_NO TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.CHARACTER_DATA TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.SQL_IDENTIFIER TO PUBLIC
GRANT USAGE ON DOMAIN INFORMATION_SCHEMA.TIME_STAMP TO PUBLIC
GRANT DBA TO SA
SET SCHEMA SYSTEM_LOBS
