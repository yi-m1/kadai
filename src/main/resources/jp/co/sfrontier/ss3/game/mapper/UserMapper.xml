<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="jp.co.sfrontier.ss3.game.mapper.UserMapper">

	<resultMap id="UserResultMap"
		type="jp.co.sfrontier.ss3.game.entity.UserInformationTbl">

		<id column="user_id" property="userId" />
		<result column="user_name" property="userName" />
		<result column="mail_address" property="mailAddress" />
		<result column="password" property="password" />
		<result column="status" property="status" />
		<result column="create_datetime" property="createDatetime" />
		<result column="update_datetime" property="updateDatetime" />
		<result column="version" property="version" />
	</resultMap>

	<select id="findByUserName" parameterType="string"
		resultMap="UserResultMap">
		SELECT * FROM user_information_tbl
		WHERE user_name =
		#{userName}
	</select>

	<select id="findByMailAddress" parameterType="string"
		resultMap="UserResultMap">
		SELECT * FROM user_information_tbl
		WHERE mail_address =
		#{mailAddress}
	</select>

	<select id="findByUserNameOrMailAddress" parameterType="string"
		resultMap="UserResultMap">
		SELECT * FROM user_information_tbl
		WHERE user_name =
		#{userNameOrMailAddress}
		OR mail_address = #{userNameOrMailAddress}
	</select>

	<insert id="addUser"
		parameterType="jp.co.sfrontier.ss3.game.entity.UserInformationTbl">
		INSERT INTO user_information_tbl(user_name,
		mail_address, password, status)
		VALUES(#{userName}, #{mailAddress},
		#{password}, #{status})
	</insert>

	<update id="updatePassword"
		parameterType="jp.co.sfrontier.ss3.game.entity.UserInformationTbl">
		UPDATE user_information_tbl
		SET password = #{password},
		update_datetime = CURRENT_TIMESTAMP,
		version = version + 1
		WHERE
		user_name = #{userName}
	</update>

</mapper>